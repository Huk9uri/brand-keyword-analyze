# Naver API credentials (Excel-based keyword volume estimation)
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=

# SQL Server connection (database-backed modules only)
DB_SERVER=
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true

# Keyword discovery rank collector
KEYWORD_DISCOVERY_DB_DATABASE=naverDB
KEYWORD_DISCOVERY_DB_USER=
KEYWORD_DISCOVERY_DB_PASSWORD=
KEYWORD_DISCOVERY_HEADLESS=true
KEYWORD_DISCOVERY_TIMEOUT_SECONDS=30
KEYWORD_DISCOVERY_ARTIFACT_ROOT=artifacts/keyword_discovery_rank

# Place representative-keyword collector
PLACE_KEYWORD_HEADLESS=true
PLACE_KEYWORD_TIMEOUT_SECONDS=30
PLACE_KEYWORD_ARTIFACT_ROOT=artifacts/place_keyword_collector
